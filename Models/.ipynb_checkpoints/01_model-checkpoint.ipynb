#Step 6: SEPARATE NUMERICAL AND CATEGORICAL FEATURES
categorical_features = [
    "sector",
    "ministry",
    "state",
    "implementing_agency_type"
] #manually listing out which columns are labelled data and not numbers

numeric_features = [
    col for col in features
    if col not in categorical_features
] #adds any columns which are not added in categorical features

print("Categorical features:", categorical_features)
print("Number of numerical features:", len(numeric_features))

#Step 7: PROCESSING THE DATA
# Handle missing numerical values
numeric_transformer = Pipeline([
    ("imputer", SimpleImputer(strategy="median")),
    ("scaler", StandardScaler())
])

# Handle categorical values
categorical_transformer = Pipeline([
    # Fill missing categorical values with the most common value
    ("imputer", SimpleImputer(strategy="most_frequent")),

    # Convert text categories into numerical columns
    ("onehot", OneHotEncoder(handle_unknown="ignore"))
])


# Combine both preprocessing pipelines
preprocessor = ColumnTransformer([
    ("num", numeric_transformer, numeric_features),
    ("cat", categorical_transformer, categorical_features)
])


print("\nPreprocessing pipeline created successfully.")

#Step 8: Training Base model - Logistic Regression 
#Target Values
y_cost_train = train["final_cost_overrun_flag"]
y_cost_test = test["final_cost_overrun_flag"]

#Creating a full pipeline
#Preprocessing to Logistic Regression
cost_model = Pipeline([
    ("preprocessor", preprocessor),
    ("classifier", LogisticRegression(
        max_iter=1000,
        class_weight="balanced"
    ))
])

#Training the model
cost_model.fit(X_train, y_cost_train)
print("\nCost Overrun Logistic Regression model trained successfully.")

#Step 9: Evaluating the Logistic Regression model
#Make predictions
y_cost_pred = cost_model.predict(X_test)

# Get probability of class 1 = cost overrun
y_cost_prob = cost_model.predict_proba(X_test)[:, 1]

# Calculate metrics
accuracy = accuracy_score(y_cost_test, y_cost_pred)
precision = precision_score(y_cost_test, y_cost_pred)
recall = recall_score(y_cost_test, y_cost_pred)
f1 = f1_score(y_cost_test, y_cost_pred)
roc_auc = roc_auc_score(y_cost_test, y_cost_prob)

print("\n--- COST OVERRUN MODEL RESULTS ---")

