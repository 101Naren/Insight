# STEP 14: EXPLAINABLE AI USING SHAP

# Extract fitted preprocessing step
fitted_preprocessor = xgb_cost_model.named_steps["preprocessor"]

# Extract fitted XGBoost classifier
fitted_xgb_classifier = xgb_cost_model.named_steps["classifier"]

# Transform test data
X_test_transformed = fitted_preprocessor.transform(X_test)

# IMPORTANT: Get transformed feature names
feature_names = fitted_preprocessor.get_feature_names_out()

# Create SHAP explainer
explainer = shap.TreeExplainer(fitted_xgb_classifier)

# Calculate SHAP values
shap_values = explainer.shap_values(X_test_transformed)

# Global explanation
shap.summary_plot(
    shap_values,
    X_test_transformed,
    feature_names=feature_names
)
# Explain the first test observation
project_index = 0

shap.force_plot(
    explainer.expected_value,
    shap_values[project_index],
    X_test_transformed[project_index],
    feature_names=feature_names,
    matplotlib=True
)

plt.show()

# Get top contributing features for a selected project

project_index = 0

project_shap_values = shap_values[project_index]

importance_df = pd.DataFrame({
    "feature": feature_names,
    "shap_value": project_shap_values
})

importance_df["absolute_importance"] = (
    importance_df["shap_value"].abs()
)

top_features = (
    importance_df
    .sort_values(
        "absolute_importance",
        ascending=False
    )
    .head(5)
)

print("\n--- TOP RISK DRIVERS ---")
print(top_features[["feature", "shap_value"]])

