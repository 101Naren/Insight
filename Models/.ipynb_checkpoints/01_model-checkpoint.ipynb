#Step12: EARLY WARNING SYSTEM
# Make sure rows are sorted by project and month
risk_results = risk_results.sort_values(
    by=["project_id", "reporting_month"]
)

# Calculate how much the risk score changed
# compared with the previous month
risk_results["risk_change"] = (
    risk_results
    .groupby("project_id")["overall_risk_score"]
    .diff()
)

# Calculate rolling 3-month risk increase
risk_results["risk_change_3m"] = (
    risk_results
    .groupby("project_id")["overall_risk_score"]
    .diff(3)
)

# Create early-warning logic
def generate_warning(row):

    score = row["overall_risk_score"]
    monthly_change = row["risk_change"]
    three_month_change = row["risk_change_3m"]

    # Critical risk
    if score >= 85:
        return "CRITICAL"

    # High risk with rapid increase
    elif score >= 70 and monthly_change >= 10:
        return "HIGH ALERT"

    # Significant increase over 3 months
    elif three_month_change >= 20:
        return "RISING RISK"

    # Medium risk
    elif score >= 40:
        return "WATCH"

    else:
        return "NORMAL"


risk_results["early_warning"] = (
    risk_results.apply(
        generate_warning,
        axis=1
    )
)

#Printing the Early warning results
print("EARLY WARNING ALERTS")

warning_projects = risk_results[
    risk_results["early_warning"].isin(
        [
            "CRITICAL",
            "HIGH ALERT",
            "RISING RISK"
        ]
    )
]

print(
    warning_projects[
        [
            "project_id",
            "reporting_month",
            "overall_risk_score",
            "risk_change",
            "risk_change_3m",
            "early_warning"
        ]
